# ==============================================================================
# FileShare Environment Configuration (.env.example)
# Copy this file to .env and customize the values for your environment.
# ==============================================================================

# ─── Environment & Security ───────────────────────────────────────────────────
# Environment mode: 'development', 'production', or 'testing'
ENVIRONMENT=production

# 64-character (or longer) secret key used for session signing and internal cryptography.
# In production, ALWAYS set this to a secure random string (e.g. `openssl rand -hex 32`).
SECRET_KEY=replace_with_a_secure_random_64_character_hex_string

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ─── Server Host & Port ───────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# Set to 1 if the backend is running behind a reverse proxy (Nginx, Traefik, Cloudflare, Vercel)
# to trust X-Forwarded-For headers for client IP resolution and rate limiting.
TRUST_PROXY=0

# ─── CORS (Cross-Origin Resource Sharing) ──────────────────────────────────────
# Comma-separated list of allowed frontend origins, or '*' for public access.
# Examples:
#   FRONTEND_ORIGIN=*
#   FRONTEND_ORIGIN=http://localhost:5173,https://fileshare.yourdomain.com
FRONTEND_ORIGIN=*
# ─── Database & Storage Paths ─────────────────────────────────────────────────
# SQLite database path (default: database/app.db or /tmp/app.db on Vercel)
DB_PATH=database/app.db

# Directory for storing encrypted file blobs (default: uploads or /tmp/uploads on Vercel)
UPLOAD_DIR=uploads

# ─── Transfer Limits & Quotas ─────────────────────────────────────────────────
# Maximum allowed file upload size in bytes (default: 2147483648 = 2 GB)
MAX_FILE_SIZE=2147483648

# Maximum QR / token refreshes allowed per transfer session
MAX_REFRESHES_PER_SESSION=5

# Maximum allowed in-browser previews per transfer file
MAX_PREVIEWS_PER_FILE=100

# ─── Background Cleanup Service ───────────────────────────────────────────────
# Interval in seconds between background sweeps for expired files and transfers (default: 300 = 5 min)
CLEANUP_INTERVAL_SECONDS=300

# Grace period in seconds for orphan disk files before being purged (default: 300 = 5 min)
ORPHAN_GRACE_PERIOD_SECONDS=300

# ─── Sliding Window Rate Limits (Requests per Window in Seconds) ───────────────
RATE_LIMIT_UPLOAD_MAX=30
RATE_LIMIT_UPLOAD_WINDOW=60

RATE_LIMIT_DOWNLOAD_MAX=120
RATE_LIMIT_DOWNLOAD_WINDOW=60

RATE_LIMIT_FILE_INFO_MAX=180
RATE_LIMIT_FILE_INFO_WINDOW=60

RATE_LIMIT_PREVIEW_MAX=40
RATE_LIMIT_PREVIEW_WINDOW=60

RATE_LIMIT_REFRESH_MAX=20
RATE_LIMIT_REFRESH_WINDOW=60

RATE_LIMIT_DELETE_MAX=30
RATE_LIMIT_DELETE_WINDOW=60

# ─── WebRTC STUN & TURN Infrastructure ────────────────────────────────────────
# Comma-separated list or JSON array of STUN server URIs
STUN_SERVERS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302,stun:stun2.l.google.com:19302,stun:global.stun.twilio.com:3478

# Optional custom TURN server configuration
# TURN_URL=turn:turn.yourdomain.com:3478
# TURN_USERNAME=your_turn_username
# TURN_CREDENTIAL=your_turn_credential

# Alternatively, pass TURN_SERVERS as a JSON array string:
# TURN_SERVERS=[{"urls":"turn:turn.yourdomain.com:3478","username":"user","credential":"pass"}]

