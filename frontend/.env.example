# ==============================================================================
# FileShare Frontend Environment Configuration (frontend/.env.example)
# Copy this file to frontend/.env or frontend/.env.local to configure Vite.
# Note: Vite requires environment variables exposed to client code to start with VITE_
# ==============================================================================

# Backend API Base URL (leave blank or omit when running with Vite proxy or on same domain)
# Examples:
#   VITE_API_URL=http://localhost:8000
#   VITE_API_URL=https://api.fileshare.yourdomain.com
VITE_API_URL=

# WebRTC Signaling Server URL (defaults to VITE_API_URL or window.location.origin)
# Example:
#   VITE_SIGNALING_URL=https://signaling.fileshare.yourdomain.com
VITE_SIGNALING_URL=

# Backend target URL for Vite development server proxy (vite.config.js)
VITE_BACKEND_URL=http://localhost:8000
# Vercel Speed Insights / Analytics (optional, set to 'true' or '1' to enable)
VITE_VERCEL_ANALYTICS=false

